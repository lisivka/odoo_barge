<odoo>
    <record id="act_report_paperformat" model="report.paperformat">
        <field name="name">A4 act</field>
        <!--            <field name="default" eval="True"/>-->
        <field name="format">A4</field>
        <!--            <field name="page_height">0</field>-->
        <!--            <field name="page_width">0</field>-->
        <!--                    <field name="orientation">Landscape</field>-->
        <field name="orientation">Portrait</field>
        <field name="margin_top">15</field>
        <field name="margin_bottom">15</field>
        <field name="margin_left">15</field>
        <field name="margin_right">15</field>
        <field name="header_line" eval="True"/>
        <!--            <field name="header_spacing">15</field>-->
        <!--            <field name="dpi">180</field>-->
    </record>


    <record id="action_report_barge_load_act" model="ir.actions.report">
        <field name="name">Barge Loading Act Report</field>
        <field name="model">barge.load.act</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">barge_load.report_barge_load_act_document</field>
        <field name="report_file">barge_load.report_barge_load_act_document</field>
        <field name="print_report_name">'Act Report - ' + object.number</field>
        <field name="binding_model_id" ref="model_barge_load_act"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="act_report_paperformat"/>
    </record>


    <template id="report_barge_load_act_document">
        <!--        <t t-call="web.external_layout">-->
        <t t-call="web.html_container">
            <style>
                .status-draft { color: white; background-color: red; padding: 5px; border-radius: 3px; }
                .status-done { color: white; background-color: green; padding: 5px; border-radius: 3px; }
                .status-other { color: black; background-color: lightgray; padding: 5px; border-radius: 3px; }
                table, th, td { border: 0px solid black; border-collapse: collapse; padding: 5px; }
                .table-condensed th, .table-condensed td { width: 60px; }
                .page-break { page-break-after: always; }
            </style>

            <main class="page">
                <t t-foreach="docs" t-as="doc">


                    <table style="border: 0px solid black; width: 100%;">
                        <tr>

                            <!-- ========Firth Column========= -->
                            <td style="width: 50%; vertical-align: top; padding-right: 15px;">
                                <h4>Barge Loading Act Report Act #
                                    <span t-field="doc.number"/>
                                </h4>
                                <p>
                                    <strong>Status:</strong>
                                    <span t-field="doc.status"/>
                                </p>

                                <p>
                                    <strong>Quarry:</strong>
                                    <span t-field="doc.quarry_id.name"/>
                                </p>
                                <p>
                                    <strong>Owner:</strong>
                                    <span t-field="doc.owner_quarry_id.name"/>
                                </p>
                                <p>
                                    <strong>Receiver:</strong>
                                    <span t-field="doc.receiver_id.name"/>
                                </p>

                                <!-- Duration Information -->
                                <p>
                                    <strong>Start Time:</strong>
                                    <span t-field="doc.start_time"/>
                                </p>
                                <p>
                                    <strong>End Time:</strong>
                                    <span t-field="doc.end_time"/>
                                </p>
                                <p>
                                    <strong>Duration:</strong>
                                    <span t-esc="int(doc.duration)"/> h <span
                                        t-esc="int((doc.duration - int(doc.duration)) * 60)"/> m
                                </p>

                            </td>

                           <!-- ========Second Column========= -->
                            <td style="width: 50%; vertical-align: top; padding-left: 15px;">
                                <h4>dated
                                    <span t-field="doc.date"/>
                                </h4>
                                <!-- Equipment Details -->
                                <p>
                                    <strong>Dredger:</strong>
                                    <span t-field="doc.dredger_id.name"/>
                                </p>
                                <p>
                                    <strong>Dredger Agent:</strong>
                                    <span t-field="doc.dredger_agent_id.name"/>
                                </p>
                                <p>
                                    <strong>Barge:</strong>
                                    <span t-field="doc.barge_id.name"/>
                                </p>
                                <p>
                                    <strong>Tugboat:</strong>
                                    <span t-field="doc.tugboat_id.name"/>
                                </p>
                                <p>
                                    <strong>Tugboat Agent:</strong>
                                    <span t-field="doc.tugboat_agent_id.name"/>
                                </p>
                                <p>
                                    <strong>Cargo Carrier:</strong>
                                    <span t-field="doc.cargo_carrier_id.name"/>
                                </p>


                            </td>
                        </tr>
                    </table>


                    <table class="table table-condensed" border="0" style="width: 100%;">
                        <tr>
                            <!-- Table for Before Loading -->
                            <td style="vertical-align: top; width: 50%;">
                                <h4>Before Loading (cm)</h4>
                                <table class="table table-condensed">
                                    <thead>
                                        <tr>
                                            <th>Draft</th>
                                            <th>T Nose</th>
                                            <th>T Mid</th>
                                            <th>T Stern</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td>Left</td>
                                            <td>
                                                <span t-field="doc.before_left_nose"/>
                                            </td>
                                            <td>
                                                <span t-field="doc.before_left_mid"/>
                                            </td>
                                            <td>
                                                <span t-field="doc.before_left_stern"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>Right</td>
                                            <td>
                                                <span t-field="doc.before_right_nose"/>
                                            </td>
                                            <td>
                                                <span t-field="doc.before_right_mid"/>
                                            </td>
                                            <td>
                                                <span t-field="doc.before_right_stern"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>T_avg</td>
                                            <td colspan="3">
                                                <span t-field="doc.before_avg_draft"/>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </td>

                            <!-- Table for After Loading -->
                            <td style="vertical-align: top; width: 50%;">
                                <h4>After Loading (cm)</h4>
                                <table class="table table-condensed">
                                    <thead>
                                        <tr>
                                            <th>Draft</th>
                                            <th>T Nose</th>
                                            <th>T Mid</th>
                                            <th>T Stern</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td>Left</td>
                                            <td>
                                                <span t-field="doc.after_left_nose"/>
                                            </td>
                                            <td>
                                                <span t-field="doc.after_left_mid"/>
                                            </td>
                                            <td>
                                                <span t-field="doc.after_left_stern"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>Right</td>
                                            <td>
                                                <span t-field="doc.after_right_nose"/>
                                            </td>
                                            <td>
                                                <span t-field="doc.after_right_mid"/>
                                            </td>
                                            <td>
                                                <span t-field="doc.after_right_stern"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>T_avg</td>
                                            <td colspan="3">
                                                <span t-field="doc.after_avg_draft"/>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </td>
                        </tr>
                    </table>


                    <table style="width: 100%;">
                        <tr>
                            <!-- ========Firth Column========= -->
                            <td style="width: 50%; vertical-align: top; padding-right: 15px;">

                                <!-- Calculation Results -->
                                <h4>Calculation</h4>
                                <p>
                                    <strong>Draft Difference:</strong>
                                    <span t-field="doc.draft_difference"/>
                                </p>
                                <p>
                                    <strong>Cargo Capacity per cm:</strong>
                                    <span t-field="doc.cargo_capacity_per_cm"/>
                                </p>
                                <p>
                                    <strong>Calculated Weight:</strong>
                                    <span t-field="doc.calculated_weight"/>
                                </p>
                                <p>
                                    <strong>Moisture Coefficient:</strong>
                                    <span t-field="doc.moisture_coefficient"/>
                                </p>
                                <p>
                                    <strong>Recorded Weight:</strong>
                                    <span t-field="doc.record_weight"/>
                                </p>

                            </td>

                            <!-- ========Second Column========= -->
                            <td style="width: 50%; vertical-align: top; padding-left: 15px;">
                                <p>
                                </p>
                            </td>
                        </tr>
                    </table>

                    <p>
                        Signature:

                    </p>
                    <p>
                        <strong>______________________________________ Dredger Agent:</strong>
                        <span t-field="doc.dredger_agent_id.name"/>
                    </p>
                    <br></br>

                    <p>
                        <strong>______________________________________ Tugboat Agent:</strong>
                        <span t-field="doc.tugboat_agent_id.name"/>
                    </p>

                    <!-- Page Break -->
                    <div class="page-break"></div>
                </t>
            </main>
        </t>
    </template>


</odoo>


