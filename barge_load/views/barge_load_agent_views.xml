<odoo>

    <record id="view_agent_tree" model="ir.ui.view">
        <field name="name">barge.load.agent.tree</field>
        <field name="model">barge.load.agent</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="user_id"/>
            </tree>
        </field>
    </record>

    <record id="view_agent_form" model="ir.ui.view">
        <field name="name">barge.load.agent.form</field>
        <field name="model">barge.load.agent</field>
        <field name="arch" type="xml">
            <form string="Agent Information">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="partner_id"/>
                        <field name="user_id"/>

                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_agent" model="ir.actions.act_window">
        <field name="name">Agent</field>
        <field name="res_model">barge.load.agent</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create the agent information here.
            </p>
        </field>
    </record>
</odoo>
