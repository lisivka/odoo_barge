<odoo>

    <record id="view_dredger_tree" model="ir.ui.view">
        <field name="name">barge.load.dredger.tree</field>
        <field name="model">barge.load.dredger</field>
        <field name="arch" type="xml">
            <tree string="Dredger">
                <field name="name"/>
                <field name="owner_id" required="1"/>
            </tree>
        </field>
    </record>

    <record id="view_dredger_form" model="ir.ui.view">
        <field name="name">barge.load.dredger.form</field>
        <field name="model">barge.load.dredger</field>
        <field name="arch" type="xml">
            <form string="Dredger Information">
                <sheet>
                    <group>
                        <field name="name" required="1"/>
                        <field name="owner_id" required="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dredger" model="ir.actions.act_window">
        <field name="name">Dredger</field>
        <field name="res_model">barge.load.dredger</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_dredger_tree"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create the dredger information here.
            </p>
        </field>
    </record>

</odoo>
