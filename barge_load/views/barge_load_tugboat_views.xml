<odoo>

    <record id="view_tugboat_tree" model="ir.ui.view">
        <field name="name">barge.load.tugboat.tree</field>
        <field name="model">barge.load.tugboat</field>
        <field name="arch" type="xml">
            <tree string="tugboat">
                <field name="name"/>
                <field name="owner_id" required="1"/>
            </tree>
        </field>
    </record>

    <record id="view_tugboat_form" model="ir.ui.view">
        <field name="name">barge.load.tugboat.form</field>
        <field name="model">barge.load.tugboat</field>
        <field name="arch" type="xml">
            <form string="tugboat Information">
                <sheet>
                    <group>
                        <field name="name" required="1"/>
                        <field name="owner_id" required="1"/>
                    </group>
                    <notebook>
                        <page string="Acts">
                            <field name="act_ids" widget="one2many_list"
                                   readonly="1"
                                   domain="[    ('quarry_id', '=', id),                ]"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_tugboat" model="ir.actions.act_window">
        <field name="name">tugboat</field>
        <field name="res_model">barge.load.tugboat</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_tugboat_tree"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create the tugboat information here.
            </p>
        </field>
    </record>

</odoo>
