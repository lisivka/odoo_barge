<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_captain_tree" model="ir.ui.view">
        <field name="name">barge.load.captain.tree</field>
        <field name="model">barge.load.captain</field>
        <field name="arch" type="xml">
            <tree string="Captains">
                <field name="name"/>
                <field name="license_number"/>
            </tree>
        </field>
    </record>


    <record id="view_captain_form" model="ir.ui.view">
        <field name="name">barge.load.captain.form</field>
        <field name="model">barge.load.captain</field>
        <field name="arch" type="xml">
            <form string="Captain Information">
                <sheet>
                    <group>
                        <field name="partner_id"/>
                        <field name="license_number"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <record id="action_captain" model="ir.actions.act_window">
        <field name="name">Captains</field>
        <field name="res_model">barge.load.captain</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create the captain's information here.
            </p>
        </field>
    </record>

</odoo>
