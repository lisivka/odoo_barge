<odoo>

    <record id="view_act_tree" model="ir.ui.view">
        <field name="name">barge.load.act.tree</field>
        <field name="model">barge.load.act</field>
        <field name="arch" type="xml">

            <tree decoration-success="status == 'done'" decoration-warning="status == 'draft'">

                <field name="number"/>
                <field name="date"/>

                <field name="owner_quarry_id" optional="show"/>
                <field name="receiver_id" optional="show"/>
                <field name="quarry_id" optional="show"/>
                <field name="dredger_id" optional="show"/>
                <field name="dredger_agent_id" optional="show"/>

                <field name="barge_id" optional="show"/>
                <field name="tugboat_id" optional="show"/>
                <field name="tugboat_agent_id" optional="show"/>


                <field name="start_time" optional="show"/>
                <field name="end_time" optional="show"/>
                <field name="duration" widget="float_time" optional="show"/>
                <field name="draft_difference" optional="hide"/>
                <field name="cargo_capacity_per_cm"/>
                <field name="calculated_weight" optional="hide"/>
                <field name="moisture_coefficient" optional="hide"/>
                <field name="record_weight" widget="float"/>
                <field name="status" widget="statusbar" optional="show"/>

            </tree>
        </field>
    </record>

    <record id="view_act_form" model="ir.ui.view">
        <field name="name">barge.load.act.form</field>
        <field name="model">barge.load.act</field>
        <field name="arch" type="xml">

            <form string="Act Information">
                <header>
                    <group>
                        <field name="status" widget="statusbar"
                               options="{'clickable': '1'}"/>
                    </group>
                </header>

                <sheet>
                    <group col="2">
                        <group>
                            <field name="number"/>
                            <field name="date"/>
                            <field name="quarry_id"/>
                            <field name="owner_quarry_id"/>
                            <field name="receiver_id"/>
                            <field name="start_time"/>
                            <field name="end_time"/>
                            <field name="duration" widget="float_time"/>

                        </group>
                        <group>
                            <field name="dredger_id"/>
                            <field name="dredger_agent_id"/>
                            <field name="barge_id"/>
                            <field name="tugboat_id"/>
                            <field name="tugboat_agent_id"/>
                            <field name="cargo_carrier_id"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Ship's draft">
                            <group col="3">

                                <!-- Table Before -->
                                <group string="Before loading, cm">
                                    <table class="table table-condensed">
                                        <thead>
                                            <tr>
                                                <th style="width: 80px;">Draft</th>
                                                <th style="width: 60px;">T nose</th>
                                                <th style="width: 60px;">T mid</th>
                                                <th style="width: 60px;">T stern</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td>Left</td>
                                                <td>
                                                    <field name="before_left_nose" widget="integer"
                                                           style="width: 60px;"/>
                                                </td>
                                                <td>
                                                    <field name="before_left_mid" widget="integer"
                                                           style="width: 60px;"/>
                                                </td>
                                                <td>
                                                    <field name="before_left_stern" widget="integer"
                                                           style="width: 60px;"/>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>Right</td>
                                                <td>
                                                    <field name="before_right_nose" widget="integer"
                                                           style="width: 60px;"/>
                                                </td>
                                                <td>
                                                    <field name="before_right_mid" widget="integer"
                                                           style="width: 60px;"/>
                                                </td>
                                                <td>
                                                    <field name="before_right_stern" widget="integer"
                                                           style="width: 60px;"/>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>T_avg</td>
                                                <td>
                                                    <field name="before_avg_draft"/>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </group>

                                <!-- Table After -->
                                <group string="After loading, cm">
                                    <table class="table table-condensed">
                                        <thead>
                                            <tr>
                                                <th style="width: 80px;">Draft</th>
                                                <th style="width: 60px;">T nose</th>
                                                <th style="width: 60px;">T mid</th>
                                                <th style="width: 60px;">T stern</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td>Left</td>
                                                <td>
                                                    <field name="after_left_nose" widget="integer"
                                                           style="width: 60px;"/>
                                                </td>
                                                <td>
                                                    <field name="after_left_mid" widget="integer" style="width: 60px;"/>
                                                </td>
                                                <td>
                                                    <field name="after_left_stern" widget="integer"
                                                           style="width: 60px;"/>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>Right</td>
                                                <td>
                                                    <field name="after_right_nose" widget="integer"
                                                           style="width: 60px;"/>
                                                </td>
                                                <td>
                                                    <field name="after_right_mid" widget="integer"
                                                           style="width: 60px;"/>
                                                </td>
                                                <td>
                                                    <field name="after_right_stern" widget="integer"
                                                           style="width: 60px;"/>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>T_avg</td>
                                                <td colspan="1">
                                                    <field name="after_avg_draft" style="width: 60px;"/>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </group>

                                <!-- Calculation -->
                                <group>
                                    <field name="draft_difference"/>
                                    <field name="cargo_capacity_per_cm"/>
                                    <field name="calculated_weight"/>
                                    <field name="moisture_coefficient"/>
                                    <field name="record_weight"/>
                                </group>

                            </group>
                        </page>
                    </notebook>


                </sheet>

                <!-- Chatter for messages -->
                <div class="oe_chatter">
                    <field name="message_ids"
                           widget="mail_thread"/>
                </div>

            </form>

        </field>
    </record>

    <record id="view_act_search" model="ir.ui.view">
        <field name="name">barge.load.act.search</field>
        <field name="model">barge.load.act</field>
        <field name="arch" type="xml">
            <search>
                <filter name="filter_status" string="Status"
                        domain="[('status', '!=', False)]"
                        context="{'group_by': 'status'}"/>
                <filter name="filter_quarry" string="Quarry"
                        domain="[('quarry_id', '!=', False)]"
                        context="{'group_by': 'quarry_id'}"/>
                <filter name="filter_receiver" string="Receiver"
                        domain="[('receiver_id', '!=', False)]"
                        context="{'group_by': 'receiver_id'}"/>
                <filter name="filter_barge" string="Barge"
                        domain="[('barge_id', '!=', False)]"
                        context="{'group_by': 'barge_id'}"/>
                <filter name="filter_tugboat" string="Tugboat"
                        domain="[('tugboat_id', '!=', False)]"
                        context="{'group_by': 'tugboat_id'}"/>
                <filter name="filter_date" string="Date"
                        domain="[('date', '!=', False)]"
                        context="{'group_by': 'date'}"/>
                <separator/>

                <filter name="filter_date" date="date" default_period="this_month"/>
                <filter name="filter_order_date" invisible="0" string="Last 30 Days"
                        domain="[('date', '&gt;=', (datetime.datetime.combine(context_today() + relativedelta(days=-30), datetime.time(0,0,0))).strftime('%Y-%m-%d %H:%M:%S'))]"/>
                <filter name="filter_order_date" invisible="0" string="Last 7 Days"
                        domain="[('date', '&gt;=', (datetime.datetime.combine(context_today() + relativedelta(days=-7), datetime.time(0,0,0))).strftime('%Y-%m-%d %H:%M:%S'))]"/>
                <separator/>

            </search>
        </field>
    </record>

    <record id="view_barge_load_act_calendar" model="ir.ui.view">
        <field name="name">barge.load.act.calendar</field>
        <field name="model">barge.load.act</field>
        <field name="arch" type="xml">
            <calendar string="Barge Loading Calendar" date_start="date" date_stop="date" color="status">
                <field name="number"/>
                <field name="quarry_id"/>
                <field name="receiver_id"/>
                <field name="barge_id"/>
                <field name="tugboat_id"/>
                <field name="status"/>
                <field name="record_weight"/>
            </calendar>
        </field>
    </record>

    <record id="view_barge_load_act_pivot" model="ir.ui.view">
        <field name="name">barge.load.act.pivot</field>
        <field name="model">barge.load.act</field>
        <field name="arch" type="xml">
            <pivot string="Barge Loading Pivot">
                <field name="quarry_id" type="row"/>

                <field name="receiver_id" type="row"/>
                <field name="status" type="col"/>
                <field name="date" type="col"/>
                <field name="record_weight" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_barge_load_act_graph" model="ir.ui.view">
        <field name="name">barge.load.act.graph</field>
        <field name="model">barge.load.act</field>
        <field name="arch" type="xml">
            <graph string="Barge Load Act - Monthly Record Weight" type="bar">

                <field name="date" interval="month" type="col"/>
                <field name="quarry_id" type="col"/>
                <field name="record_weight" type="measure"/>

            </graph>
        </field>
    </record>


    <record id="action_act" model="ir.actions.act_window">
        <field name="name">Acts</field>
        <field name="res_model">barge.load.act</field>
        <field name="view_mode">tree,form,calendar,pivot,graph</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create the barge load act here.
            </p>
        </field>
    </record>
</odoo>
