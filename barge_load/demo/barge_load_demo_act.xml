               eval="(DateTime.now() - timedelta(days=8, hours=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="end_time"
               eval="(DateTime.now() - timedelta(days=8)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="quarry_id" ref="quarry_3"/>
        <field name="owner_quarry_id">13</field>
        <field name="receiver_id">13</field>
        <field name="dredger_agent_id">21</field>
        <field name="tugboat_agent_id">22</field>
        <field name="dredger_id" ref="dredger_2"/>
