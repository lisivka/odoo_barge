<odoo>
    <!-- Форма для візарда масового оновлення статусу акта -->
    <record id="view_mass_update_act_wizard" model="ir.ui.view">
        <field name="name">mass.update.act.wizard.form</field>
        <field name="model">mass.update.act.wizard</field>
        <field name="arch" type="xml">
            <form string="Mass Update Act Status">
                <group>
                    <field name="new_status"/>
                </group>
                <footer>
                    <button string="Apply" type="object" name="action_update_act" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Дія для візарда   -->
    <record id="action_mass_update_act_wizard" model="ir.actions.act_window">
        <field name="name">Mass Update Act Status</field>
        <field name="res_model">mass.update.act.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'active_ids': active_ids}</field>
    </record>


    <!-- Дія для масового оновлення статусу у перегляді списку -->
    <record id="action_mass_update_act" model="ir.actions.server">
        <field name="name">Mass Update Act Status</field>
        <field name="model_id" ref="model_barge_load_act"/>
        <field name="binding_model_id" ref="model_barge_load_act"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
            action = {
            'type': 'ir.actions.act_window',
            'name': 'Mass Update Act Status',
            'res_model': 'mass.update.act.wizard',
            'view_mode': 'form',
            'target': 'new',
            'context': {'active_ids': env.context.get('active_ids', [])},
            }
        </field>
    </record>
</odoo>
